# ==============================================================
#  英語学習アプリの設定ファイル（見本）
#  このファイルをコピーして「.env.local」という名前で保存し、値を入力してください。
#    cp .env.example .env.local
#  .env.local は Git に含まれません（APIキーが漏れないようにするため）。
# ==============================================================

# --- 必須：OpenAI APIキー ------------------------------------
# AI英会話（音声）・会話後のフィードバック・文法問題・英作文添削のすべてで使います。
# 取得先: https://platform.openai.com/api-keys
# ※ キーはサーバー側だけで使われ、ブラウザには送られません。
#   音声会話では、サーバーが数分で失効する「一時キー」を発行してブラウザに渡します。
OPENAI_API_KEY=

# --- 任意：使用するモデル（空欄ならカッコ内の既定値） ----------
# リアルタイム音声会話のモデル（既定: gpt-realtime）
#   料金を抑えたい場合は gpt-realtime-mini を指定してください。
OPENAI_REALTIME_MODEL=
# 音声会話中にあなたの発話を文字起こしするモデル（既定: gpt-4o-mini-transcribe）
OPENAI_TRANSCRIBE_MODEL=
# 添削・採点・問題作成に使うテキストモデル（既定: gpt-5.4-mini）
OPENAI_TEXT_MODEL=

# --- 任意：保存先・タイムゾーン ---------------------------------
# 学習記録を保存する SQLite ファイルの場所（既定: ./data/app.db）
DATABASE_PATH=
# 「今日の学習時間」や連続学習日数を数えるタイムゾーン（既定: Asia/Tokyo）
APP_TIMEZONE=

# --- 任意：アクセス用パスワード ---------------------------------
# 自分のPCだけで使うなら空欄でOK。
# インターネット上に公開する場合は必ず設定してください（他人にAPIを使われるのを防ぎます）。
APP_PASSWORD=
